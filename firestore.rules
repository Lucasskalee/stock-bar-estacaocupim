rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 5
        && request.auth.token.email.size() <= 128;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function isValidWorkspaceId(workspaceId) {
      return workspaceId == 'estacao-cupim';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(emailId) {
      return emailId is string
        && emailId.size() >= 5
        && emailId.size() <= 128
        && emailId.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && authEmail() == 'skalee.razarth@gmail.com';
    }

    function memberDocPath(workspaceId, emailId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(emailId);
    }

    function isWorkspaceAdmin(workspaceId) {
      return isBootstrapAdmin()
        || (
          isVerifiedUser()
          && isValidWorkspaceId(workspaceId)
          && exists(memberDocPath(workspaceId, authEmail()))
          && get(memberDocPath(workspaceId, authEmail())).data.role == 'admin'
        );
    }

    function isTeamMember(workspaceId) {
      return isBootstrapAdmin()
        || (
          isVerifiedUser()
          && isValidWorkspaceId(workspaceId)
          && exists(memberDocPath(workspaceId, authEmail()))
        );
    }

    function isValidNullableStock(val) {
      return val == null || ((val is int || val is float) && val >= 0 && val <= 100000);
    }

    function isValidCategory(cat) {
      return cat is string
        && cat.size() >= 1
        && cat.size() <= 30
        && cat in ['Cerveja', 'Refrigerante', 'Água', 'Suco', 'Destilado', 'Vinho', 'Outros'];
    }

    function isValidDateISO(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // --- Validation Blueprints (Anti-Update-Gap) ---
    function isValidTeamMember(data, workspaceId, memberEmail) {
      return data.keys().hasAll([
          'workspaceId',
          'email',
          'nome',
          'role',
          'addedByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId',
          'email',
          'nome',
          'role',
          'addedByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.workspaceId == workspaceId
        && isValidWorkspaceId(data.workspaceId)
        && isValidEmailId(data.email)
        && data.email == memberEmail
        && data.nome is string
        && data.nome.size() >= 1
        && data.nome.size() <= 80
        && data.role is string
        && data.role in ['admin', 'operador']
        && data.addedByUid is string
        && isValidId(data.addedByUid)
        && data.addedByUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBeverage(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId',
          'createdByUid',
          'updatedByUid',
          'updatedByName',
          'nome',
          'categoria',
          'inicial',
          'final',
          'ideal',
          'checkedInicial',
          'checkedFinal',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId',
          'createdByUid',
          'updatedByUid',
          'updatedByName',
          'nome',
          'categoria',
          'inicial',
          'final',
          'ideal',
          'checkedInicial',
          'checkedFinal',
          'createdAt',
          'updatedAt'
        ])
        && data.workspaceId == workspaceId
        && isValidWorkspaceId(data.workspaceId)
        && data.createdByUid is string
        && isValidId(data.createdByUid)
        && data.updatedByUid is string
        && isValidId(data.updatedByUid)
        && data.updatedByUid == request.auth.uid
        && data.updatedByName is string
        && data.updatedByName.size() >= 1
        && data.updatedByName.size() <= 80
        && data.nome is string
        && data.nome.size() >= 1
        && data.nome.size() <= 120
        && isValidCategory(data.categoria)
        && isValidNullableStock(data.inicial)
        && isValidNullableStock(data.final)
        && isValidNullableStock(data.ideal)
        && data.checkedInicial is bool
        && data.checkedFinal is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidShiftMeta(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId',
          'dataOperacional',
          'abertoEm',
          'updatedByUid',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId',
          'dataOperacional',
          'abertoEm',
          'updatedByUid',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ])
        && data.workspaceId == workspaceId
        && isValidWorkspaceId(data.workspaceId)
        && isValidDateISO(data.dataOperacional)
        && data.abertoEm is string
        && data.abertoEm.size() >= 10
        && data.abertoEm.size() <= 40
        && data.updatedByUid is string
        && isValidId(data.updatedByUid)
        && data.updatedByUid == request.auth.uid
        && data.updatedByName is string
        && data.updatedByName.size() >= 1
        && data.updatedByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidShiftRecord(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId',
          'createdByUid',
          'closedByName',
          'dataOperacional',
          'abertoEm',
          'encerradoEm',
          'rotulo',
          'totalItens',
          'itensConferidos',
          'totalConsumo',
          'totalPedir',
          'consumoPorCategoria',
          'itens',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'workspaceId',
          'createdByUid',
          'closedByName',
          'dataOperacional',
          'abertoEm',
          'encerradoEm',
          'rotulo',
          'totalItens',
          'itensConferidos',
          'totalConsumo',
          'totalPedir',
          'consumoPorCategoria',
          'itens',
          'createdAt'
        ])
        && data.workspaceId == workspaceId
        && isValidWorkspaceId(data.workspaceId)
        && data.createdByUid is string
        && isValidId(data.createdByUid)
        && data.createdByUid == request.auth.uid
        && data.closedByName is string
        && data.closedByName.size() >= 1
        && data.closedByName.size() <= 80
        && isValidDateISO(data.dataOperacional)
        && data.abertoEm is string
        && data.abertoEm.size() >= 10
        && data.abertoEm.size() <= 40
        && data.encerradoEm is string
        && data.encerradoEm.size() >= 10
        && data.encerradoEm.size() <= 40
        && data.rotulo is string
        && data.rotulo.size() >= 1
        && data.rotulo.size() <= 60
        && (data.totalItens is int || data.totalItens is float)
        && data.totalItens >= 0 && data.totalItens <= 500
        && (data.itensConferidos is int || data.itensConferidos is float)
        && data.itensConferidos >= 0 && data.itensConferidos <= 500
        && (data.totalConsumo is int || data.totalConsumo is float)
        && data.totalConsumo >= 0 && data.totalConsumo <= 1000000
        && (data.totalPedir is int || data.totalPedir is float)
        && data.totalPedir >= 0 && data.totalPedir <= 1000000
        && data.consumoPorCategoria is map
        && data.consumoPorCategoria.keys().hasOnly([
          'Cerveja', 'Refrigerante', 'Água', 'Suco', 'Destilado', 'Vinho', 'Outros'
        ])
        && data.itens is list
        && data.itens.size() <= 200
        && (data.itens.size() == 0 || data.itens[0] is map)
        && data.createdAt is timestamp;
    }

    // --- Collection: Authorized Team Roster (PII Isolated) ---
    match /workspaces/{workspaceId}/members/{memberEmail} {
      // Users can check their own membership doc; admins can read any member doc
      allow get: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && isValidEmailId(memberEmail)
        && (resource == null || existing().workspaceId == workspaceId)
        && (
          authEmail() == memberEmail
          || isWorkspaceAdmin(workspaceId)
        );

      // Only workspace admins can list the team roster
      allow list: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && existing().workspaceId == workspaceId
        && isWorkspaceAdmin(workspaceId);

      allow create: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && isValidEmailId(memberEmail)
        && isValidTeamMember(incoming(), workspaceId, memberEmail)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isWorkspaceAdmin(workspaceId);

      allow update: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && isValidEmailId(memberEmail)
        && memberEmail != 'skalee.razarth@gmail.com'
        && isValidTeamMember(incoming(), workspaceId, memberEmail)
        && existing().workspaceId == workspaceId
        && incoming().workspaceId == existing().workspaceId
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['nome', 'role', 'addedByUid', 'updatedAt'])
        && isWorkspaceAdmin(workspaceId);

      allow delete: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && isValidEmailId(memberEmail)
        && memberEmail != 'skalee.razarth@gmail.com'
        && existing().workspaceId == workspaceId
        && isWorkspaceAdmin(workspaceId);
    }

    // --- Collection: Shared Beverages ---
    match /workspaces/{workspaceId}/beverages/{beverageId} {
      allow get: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && isValidId(beverageId)
        && existing().workspaceId == workspaceId
        && isTeamMember(workspaceId);

      allow list: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && existing().workspaceId == workspaceId
        && isTeamMember(workspaceId);

      allow create: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && isValidId(beverageId)
        && isValidBeverage(incoming(), workspaceId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isTeamMember(workspaceId);

      allow update: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && isValidId(beverageId)
        && isValidBeverage(incoming(), workspaceId)
        && existing().workspaceId == workspaceId
        && incoming().workspaceId == existing().workspaceId
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isWorkspaceAdmin(workspaceId) ||
          // Action: Edit beverage metadata
          incoming().diff(existing()).affectedKeys().hasOnly([
            'nome', 'categoria', 'ideal', 'updatedByUid', 'updatedByName', 'updatedAt'
          ]) ||
          // Action: Update stock count / checklist state
          incoming().diff(existing()).affectedKeys().hasOnly([
            'inicial', 'final', 'ideal', 'checkedInicial', 'checkedFinal', 'updatedByUid', 'updatedByName', 'updatedAt'
          ])
        )
        && isTeamMember(workspaceId);

      allow delete: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && isValidId(beverageId)
        && existing().workspaceId == workspaceId
        && isTeamMember(workspaceId);
    }

    // --- Collection: Shared Current Shift Metadata ---
    match /workspaces/{workspaceId}/meta/{metaId} {
      allow get: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && metaId == 'currentShift'
        && (resource == null || existing().workspaceId == workspaceId)
        && isTeamMember(workspaceId);

      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && metaId == 'currentShift'
        && isValidShiftMeta(incoming(), workspaceId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isTeamMember(workspaceId);

      allow update: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && metaId == 'currentShift'
        && isValidShiftMeta(incoming(), workspaceId)
        && existing().workspaceId == workspaceId
        && incoming().workspaceId == existing().workspaceId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isWorkspaceAdmin(workspaceId) ||
          // Action: Change operational shift date
          incoming().diff(existing()).affectedKeys().hasOnly([
            'dataOperacional', 'updatedByUid', 'updatedByName', 'updatedAt'
          ]) ||
          // Action: Roll over to next shift
          incoming().diff(existing()).affectedKeys().hasOnly([
            'dataOperacional', 'abertoEm', 'updatedByUid', 'updatedByName', 'updatedAt'
          ])
        )
        && isTeamMember(workspaceId);

      allow delete: if false;
    }

    // --- Collection: Shared Closed Shift History (Immutable after creation) ---
    match /workspaces/{workspaceId}/shifts/{shiftId} {
      allow get: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && isValidId(shiftId)
        && existing().workspaceId == workspaceId
        && isTeamMember(workspaceId);

      allow list: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && existing().workspaceId == workspaceId
        && isTeamMember(workspaceId);

      allow create: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && isValidId(shiftId)
        && isValidShiftRecord(incoming(), workspaceId)
        && incoming().createdAt == request.time
        && isTeamMember(workspaceId);

      allow update: if false;

      // Tier 1 Admin only: operators cannot erase historical shift records
      allow delete: if isVerifiedUser()
        && isValidWorkspaceId(workspaceId)
        && isValidId(shiftId)
        && existing().workspaceId == workspaceId
        && isWorkspaceAdmin(workspaceId);
    }
  }
}
